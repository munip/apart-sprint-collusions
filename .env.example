# Copy to .env (gitignored). Only the keys for providers you use are needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Local open-weights via Ollama (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
# default model profile: scripted | cloud | local | mixed | same_family
CLAB_PROFILE=scripted
