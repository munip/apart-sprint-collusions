# Copy to .env (gitignored) in the repo root, or keep using C:\collusions-claude\.env (also auto-loaded).
# Only fill the providers you use. `clab providers list` shows which keys were found.
# `clab providers import-fcm --write` copies keys from free-coding-models' ~/.free-coding-models.json.

# ---- default profile: scripted | free | free_homogeneous | fcm | free_weak_monitor | local | cloud | mixed
CLAB_PROFILE=scripted

# ---- paid
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- free tiers (same env names free-coding-models uses)
GROQ_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
CODESTRAL_API_KEY=
SAMBANOVA_API_KEY=
# a GitHub PAT with "models:read"; falls back to GITHUB_TOKEN
GITHUB_MODELS_TOKEN=
# Hugging Face inference router
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
FIREWORKS_API_KEY=
ZAI_API_KEY=
SCALEWAY_API_KEY=
DASHSCOPE_API_KEY=
NOVITA_API_KEY=
OVH_AI_ENDPOINTS_ACCESS_TOKEN=
LLM7_API_KEY=
# Ollama Cloud (not needed for local Ollama)
OLLAMA_API_KEY=

# ---- local / routers / gateways
OLLAMA_BASE_URL=http://localhost:11434/v1
# free-coding-models Smart Router
FCM_BASE_URL=http://localhost:19280/v1
# LiteLLM proxy / Portkey / any OpenAI-compatible gateway
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
